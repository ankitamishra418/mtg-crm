<?php
   $table_data = array(_l('clients_list_full_name'));
   if(is_gdpr() && get_option('gdpr_enable_consent_for_contacts') == '1'){
         array_push($table_data, array(
            'name'=>_l('gdpr_consent') .' ('._l('gdpr_short').')',
            'th_attrs'=>array('id'=>'th-consent', 'class'=>'not-export')
         ));
   }
  $table_data = array_merge($table_data, array(_l('Primary Contact'),_l('date_birth'),_l('Age'),_l('client_email'),_l('client_phonenumber'),_l('Location'),_l('contact_active'),_l('Vulnerable client')));
//    ,_l('contact_position') CAN ADD POSITION 
//    ,_l('clients_list_last_login') CAN ADD LAST LOGIN 
//    ,_l('Occupation Class') CAN ADD OCCUPATION CLASS
// _l('Primary Contact'),
   if ($choose) {
      $custom_fields = get_custom_fields('choose-contacts',array('show_on_table'=>1));
      foreach($custom_fields as $field){
         array_push($table_data,$field['name']);
      }
      echo render_datatable($table_data,'choose-contacts'); 
   } else {
      $custom_fields = get_custom_fields('contacts',array('show_on_table'=>1));
      foreach($custom_fields as $field){
         array_push($table_data,$field['name']);
      }
      echo render_datatable($table_data,'contacts');
   }
   ?>
<?php } ?>
<div id="contact_data"></div>
<div id="consent_data"></div>


<script>
  
function myPrimaryContact(id) {

var actionURL = "<?php echo base_url('admin/Clients/primaryContact')?>"
var individeal = id;
var checkBox = document.getElementById("P_" + individeal);

if (checkBox.checked == true) {
   var primary_checkVal = 1;
} else {
   var primary_checkVal = 0;
}
$.ajax({
   type: 'POST',
   url: actionURL,
   data: {
      primary_checkVal: primary_checkVal,
      individeal: individeal
   },
   datatype: "json",
   success: function(data) {
      console.log(data);
   }
})
}

function myClientfunctions(id) {
   var actionURL = "<?php echo base_url('admin/Clients/vulnerableCheckData_tbl')?>"
   var individeal_id = id;
   var checkBox = document.getElementById("d_" + individeal_id);
 
   if (checkBox.checked == true) {
      var vulnerable_checkValue = 1;
   } else {
      var vulnerable_checkValue = 0;
   }
   $.ajax({
      type: 'POST',
      url: actionURL,
      data: {
         vulnerable_checkValue: vulnerable_checkValue,
         individeal_id: individeal_id,
        
      },
      datatype: "json",
      success: function(data) {
         console.log(data);
      }
   })
}
</script>